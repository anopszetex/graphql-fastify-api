{
  "name": "@anopszetex/graphql-fastify-api",
  "version": "1.0.0",
  "description": "GraphQL API with Fastify, Mercurius, PostgreSQL and testcontainers",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --env-file=.env --ext js,graphql bin/index.js",
    "test": "node --test",
    "test:env": "node --test  --env-file=.env",
    "test:watch": "node --test --watch              ",
    "db:prepare": "yarn knex:migrate && yarn knex:seed",
    "knex:migrate": "knex migrate:latest",
    "knex:seed": "knex seed:run",
    "lint:ci": "eslint --ext .js",
    "lint": "yarn lint:ci --fix",
    "format": "prettier . -w -u",
    "format:check": "prettier . -c -u"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anopszetex/graphql-fastify-api.git"
  },
  "bugs": {
    "url": "https://github.com/anopszetex/graphql-fastify-api/issues"
  },
  "homepage": "https://github.com/anopszetex/graphql-fastify-api#readme",
  "dependencies": {
    "@graphql-tools/load-files": "^7.0.0",
    "@graphql-tools/merge": "^9.0.3",
    "@graphql-tools/schema": "^10.0.3",
    "close-with-grace": "^1.3.0",
    "fastify": "^4.26.1",
    "graphql": "^16.8.1",
    "knex": "^3.1.0",
    "mercurius": "^13.3.3",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@testcontainers/postgresql": "^10.9.0",
    "eslint": "^8.56.0",
    "eslint-config-google": "^0.14.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.1.1",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "testcontainers": "^10.9.0"
  }
}
